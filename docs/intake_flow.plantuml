@startuml
start
:Наступило время приёма;
:Показать напоминание;
:Пациент выбирает результат;
if (Лекарство принято?) then (да)
  :Сохранить фактическое время;
  :Установить статус «Принято»;
else (нет)
  if (Приём перенесён?) then (да)
    :Установить статус «Перенесено»;
  else (нет)
    :Установить статус «Пропущено»;
  endif
endif
:Сохранить комментарий;
stop
@enduml

