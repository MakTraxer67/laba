<mxfile host="app.diagrams.net" modified="2026-09-13T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="medtrack" name="MedTrack">
    <mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="note" value="&lt;div style=&quot;font-size:20px;text-align:center;&quot;&gt;&lt;b&gt;MedTrack&lt;/b&gt;&lt;br&gt;Учёт приёма лекарств у пациента&lt;/div&gt;&lt;br&gt;&lt;b&gt;Предметная область.&lt;/b&gt; Учёт назначений врача и фактического приёма лекарств пациентом.&lt;br&gt;&lt;br&gt;&lt;b&gt;Проблема.&lt;/b&gt; Пациент может забыть приём, перепутать время или дозировку; врачу сложно получить достоверную историю соблюдения назначений. Система не ставит диагноз и не заменяет врача.&lt;br&gt;&lt;br&gt;&lt;b&gt;Цель.&lt;/b&gt; Снизить число пропусков и обеспечить контроль выполнения назначений.&lt;br&gt;&lt;br&gt;&lt;b&gt;Пользователи.&lt;/b&gt;&lt;br&gt;• Пациент — смотрит расписание, получает напоминания, отмечает результат.&lt;br&gt;• Врач — создаёт назначения и контролирует историю.&lt;br&gt;• Администратор — управляет пользователями и справочником препаратов.&lt;br&gt;&lt;br&gt;&lt;b&gt;Функции.&lt;/b&gt; Авторизация; карточки пациентов и препаратов; назначения; расписание; напоминания; статусы «принято», «пропущено», «перенесено»; история; статистика и отчёт.&lt;br&gt;&lt;br&gt;&lt;b&gt;Сущности.&lt;/b&gt; Пользователь, Пациент, Врач, Препарат, Назначение, Расписание, Приём, Напоминание.&lt;br&gt;&lt;br&gt;&lt;b&gt;Архитектура.&lt;/b&gt; Интерфейс → бизнес-логика → репозиторий → база данных.&lt;br&gt;&lt;br&gt;&lt;b&gt;Реализация.&lt;/b&gt; Python, консольный интерфейс, SQLite." style="rounded=1;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=top;spacing=16;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="420" height="900" as="geometry"/>
        </mxCell>

        <mxCell id="uc-title" value="&lt;b&gt;1. USE CASE — взаимодействие с системой&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="470" y="20" width="1100" height="30" as="geometry"/>
